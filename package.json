{
  "name": "next-formily",
  "private": true,
  "description": "NextFormily - Formily React 19 + antd 6 fork (NextFormily)",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=18"
    }
  },
  "scripts": {
    "build": "rimraf -rf packages/*/{lib,dist,esm} && pnpm -r run build",
    "build:docs": "dumi build",
    "start": "dumi dev",
    "test": "jest --coverage",
    "test:reactive": "jest packages/reactive/",
    "test:validator": "jest packages/validator/",
    "test:core": "jest packages/core/",
    "test:core:watch": "npm run test:core --- --watch",
    "test:schema": "jest packages/json-schema/",
    "test:schema:watch": "npm run test:schema --- --watch",
    "test:react": "jest packages/react/",
    "test:shared": "jest packages/shared/",
    "test:path": "jest packages/path/",
    "test:react:watch": "npm run test:react --- --watch",
    "test:antd": "jest packages/antd/",
    "test:watch": "jest --watch",
    "test:prod": "jest --coverage --silent",
    "preversion": "pnpm install --ignore-engines && git add -A && npm run build && npm run lint && npm run test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "resolutions": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@mapbox/hast-util-to-jsx": "~1.0.0",
    "yargs": "^16.x",
    "commander": "^6.x",
    "ttypescript": "1.5.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/prompt-cli": "^21.2.0",
    "@netlify/functions": "^5.3.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/hoist-non-react-statics": "^3.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-is": "^19.0.0",
    "antd": "^6.0.0",
    "axios": "^1.6.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.4",
    "conventional-commit-types": "^3.0.0",
    "cool-path": "^1.0.6",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "cz-conventional-changelog": "^2.1.0",
    "dumi": "^2.4.49",
    "escape-string-regexp": "^5.0.0",
    "file-loader": "^6.2.0",
    "findup": "^0.1.5",
    "fs-extra": "^11.4.0",
    "ghooks": "^2.0.4",
    "glob": "^13.0.6",
    "html-webpack-plugin": "^5.6.8",
    "immutable": "^5.1.9",
    "istanbul-lib-coverage": "^3.2.2",
