{
  "name": "@next-formily/react",
  "version": "3.1.1",
  "gitHead": "ac79c196ae9324889aca5e0501146f9b37b04283",
  "homepage": "https://github.com/alibaba/formily#readme",
  "bugs": {
    "url": "https://github.com/alibaba/formily/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/formily.git"
  },
  "files": [
    "lib",
    "esm"
  ],
  "main": "lib",
  "module": "esm",
  "types": "esm/index.d.ts",
  "unpkg": "dist/formily.react.umd.production.js",
  "jsdelivr": "dist/formily.react.umd.production.js",
  "jsnext:main": "esm",
  "umd:main": "dist/formily.react.umd.production.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "dumi dev",
    "build": "rimraf -rf lib esm dist && npm run build:cjs && npm run build:esm && npm run build:umd",
    "build:cjs": "rimraf -rf lib && node ../../scripts/esbuild-cjs.js && tsc --project tsconfig.build.json --emitDeclarationOnly --module esnext --outDir lib",
    "build:esm": "tsc --project tsconfig.build.json --module esnext --outDir esm",
    "build:umd": "rollup --config",
    "build:docs": "dumi build"
  },
  "dependencies": {
    "@next-formily/core": "workspace:*",
    "@next-formily/json-schema": "workspace:*",
    "@next-formily/reactive": "workspace:*",
    "@next-formily/reactive-react": "workspace:*",
    "@next-formily/shared": "workspace:*",
    "@next-formily/validator": "workspace:*",
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "dumi": "^1.1.0-rc.8"
  },
  "peerDependencies": {
    "@types/react": ">=16.8.0",
    "@types/react-dom": ">=16.8.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-is": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "engines": {
    "npm": ">=3.0.0"
  }
}
