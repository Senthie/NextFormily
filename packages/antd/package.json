{
  "name": "@next-formily/antd",
  "version": "3.1.1",
  "gitHead": "ac79c196ae9324889aca5e0501146f9b37b04283",
  "homepage": "https://github.com/alibaba/formily#readme",
  "bugs": {
    "url": "https://github.com/alibaba/formily/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/formily.git"
  },
  "files": [
    "lib",
    "esm"
  ],
  "sideEffects": [
    "dist/*",
    "esm/*.js",
    "lib/*.js",
    "src/*.ts",
    "*.less",
    "**/*/style.js"
  ],
  "main": "lib",
  "module": "esm",
  "types": "esm/index.d.ts",
  "unpkg": "dist/formily.antd.umd.production.js",
  "jsdelivr": "dist/formily.antd.umd.production.js",
  "jsnext:main": "esm",
  "umd:main": "dist/formily.antd.umd.production.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "dumi dev",
    "build": "rimraf -rf lib esm dist && npm run create:style && npm run build:cjs && npm run build:esm && npm run build:umd && npm run build:style",
    "create:style": "node ../../scripts/run-ts.cjs create-style.ts",
    "build:style": "node ../../scripts/run-ts.cjs build-style.ts",
    "build:cjs": "rimraf -rf lib && node ../../scripts/esbuild-cjs.js && tsc --project tsconfig.build.json --emitDeclarationOnly --module esnext --outDir lib",
    "build:esm": "tsc --project tsconfig.build.json --module esnext --outDir esm && node ../../scripts/copy-less.js",
    "build:umd": "rollup --config",
    "build:docs": "dumi build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^7.0.0",
    "@next-formily/core": "workspace:*",
    "@next-formily/grid": "workspace:*",
    "@next-formily/json-schema": "workspace:*",
    "@next-formily/react": "workspace:*",
    "@next-formily/reactive": "workspace:*",
    "@next-formily/reactive-react": "workspace:*",
    "@next-formily/shared": "workspace:*",
    "classnames": "^2.2.6",
    "dayjs": "^1.11.0",
    "react-sticky-box": "^0.9.3"
  },
  "devDependencies": {
    "@umijs/plugin-sass": "^1.1.1",
    "dumi": "^1.1.0-rc.8"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@types/react": ">=18.0.0",
    "@types/react-dom": ">=18.0.0",
    "antd": "^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-is": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "engines": {
    "npm": ">=3.0.0"
  }
}
