{
  "name": "@next-formily/shared",
  "version": "3.0.1",
  "gitHead": "ac79c196ae9324889aca5e0501146f9b37b04283",
  "homepage": "https://github.com/alibaba/formily#readme",
  "bugs": {
    "url": "https://github.com/alibaba/formily/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/formily.git"
  },
  "files": [
    "lib",
    "esm"
  ],
  "main": "lib",
  "module": "esm",
  "types": "esm/index.d.ts",
  "unpkg": "dist/formily.shared.umd.production.js",
  "jsdelivr": "dist/formily.shared.umd.production.js",
  "jsnext:main": "esm",
  "umd:main": "dist/formily.shared.umd.production.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf -rf lib esm dist && npm run build:cjs && npm run build:esm && npm run build:umd",
    "build:cjs": "rimraf -rf lib && node ../../scripts/esbuild-cjs.js && tsc --project tsconfig.build.json --emitDeclarationOnly --module esnext --outDir lib",
    "build:esm": "tsc --project tsconfig.build.json --module esnext --outDir esm",
    "build:umd": "rollup --config"
  },
  "dependencies": {
    "@next-formily/path": "3.0.1"
  },
  "engines": {
    "npm": ">=3.0.0"
  }
}
