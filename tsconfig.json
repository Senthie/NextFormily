{
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "module": "esnext",
    "target": "esnext",
    "strict": false,
    "noUnusedLocals": false,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "experimentalDecorators": true,
    "paths": {
      "@next-formily/*": ["./packages/*/src", "./devtools/*/src"]
    },
    "preserveSymlinks": true,
    "types": ["node"],
    "lib": ["ESNext"]
  }
}
